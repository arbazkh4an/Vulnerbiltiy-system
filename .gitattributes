# Handle line endings automatically for files detected as text
# and leave binary files untouched.
* text=auto

# Force bash scripts to always use LF, even on Windows
# to avoid execution issues in Linux/Docker environments.
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.md text eol=lf
