# SentinelAI Backend Environment Variables
# Copy to .env and fill in real values

# Database (required)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# AI Provider (at least one required)
GROQ_API_KEY=
OPENAI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# NVD API (optional, increases rate limit from 6 to 50 req/min)
NVD_API_KEY=

# CORS (comma-separated origins, * for all)
CORS_ORIGINS=["*"]

# Scanning
SCAN_TIMEOUT=30
TOTAL_SCAN_TIMEOUT=90

# Worker
WORKER_POLL_INTERVAL=5

# Rate Limiting
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_HOURS=1

# Logging
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=5000

# JWT
JWT_SECRET=your-jwt-secret-at-least-32-chars-long
JWT_ALGORITHM=HS256
